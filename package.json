{
  "name": "mcpilot-adaptive-interactive-play-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "release:check": "node scripts/check-release.mjs",
    "submission:status": "node scripts/check-submission.mjs",
    "submission:check": "node scripts/check-submission.mjs --strict",
    "submission:pack:preview": "node scripts/pack-submission.mjs --preview",
    "submission:pack": "node scripts/pack-submission.mjs",
    "submission:pack:check": "node scripts/pack-submission.mjs --check",
    "submission:media-status": "node scripts/check-media.mjs",
    "submission:media-check": "node scripts/check-media.mjs --strict",
    "media:preflight": "node scripts/check-media-tools.mjs",
    "media:images:preview": "node scripts/compose-media-images.mjs --preview",
    "media:images": "node scripts/compose-media-images.mjs",
    "media:channel": "node scripts/render-channel-assets.mjs",
    "media:narration": "node --env-file=.env.local scripts/render-realtime-narration.mjs",
    "media:captions": "node scripts/render-narration-captions.mjs",
    "media:master": "node scripts/render-competition-master.mjs",
    "media:master:preview": "node scripts/render-competition-master.mjs --preview",
    "art:hazards": "node scripts/generate-hazard-assets.mjs",
    "video:kit:preview": "node scripts/render-video-kit.mjs --preview",
    "video:kit": "node scripts/render-video-kit.mjs",
    "verify:clean": "node scripts/verify-clean-checkout.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "react-server-dom-webpack": "^19.2.8",
    "sharp": "0.35.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.126.0",
    "ws": "^8.21.0"
  },
  "type": "module"
}
